# Set default behavior to automatically normalize line endings
* text=auto

# Force LF line endings for scripts, configuration, Dockerfiles, and compose files
*.sh text eol=lf
*.conf text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
mvnw text eol=lf

# Force CRLF for Windows specific batch files
*.bat text eol=crlf
*.cmd text eol=crlf
