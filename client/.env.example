# Frontend Environment Variables
# Copy this file to .env.local for local development.
# DO NOT commit .env.local — it is git-ignored.
#
# --- Local Development ---
# The full URL to the Spring Boot backend.
# Leave empty (or remove this line) in production: the single-origin Nginx
# reverse-proxy serves /api/* from the same domain as the frontend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# --- Production (Docker Compose, single-origin behind Nginx) ---
# Set NEXT_PUBLIC_API_BASE_URL to an empty string (or omit it entirely) so
# all API calls use relative paths and flow through Nginx to the backend.
# NEXT_PUBLIC_API_BASE_URL=
