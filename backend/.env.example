# Backend Environment Variables — Template
# Copy this file to backend/.env for local development.
# backend/.env is git-ignored. Never commit real secrets.
#
# Set SPRING_PROFILES_ACTIVE=local for local development.
# Set SPRING_PROFILES_ACTIVE=prod for production (Docker Compose).

# ── Spring Profile ────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Database ──────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5433/codeprism
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── AI (Google Gemini) ────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_ME

# ── GitHub OAuth2 ─────────────────────────────────────────────────────────
# Create a GitHub OAuth App at https://github.com/settings/developers
# Local: Homepage URL = http://localhost:3000
#        Callback URL = http://localhost:8081/login/oauth2/code/github
# Prod : Homepage URL = https://<cloudfront-id>.cloudfront.net
#        Callback URL = https://<cloudfront-id>.cloudfront.net/login/oauth2/code/github
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME

# ── Frontend URL ──────────────────────────────────────────────────────────
# Local: http://localhost:3000
# Prod : https://<cloudfront-id>.cloudfront.net
FRONTEND_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must match FRONTEND_URL in prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Token Encryption ──────────────────────────────────────────────────────
# PRODUCTION ONLY: generate strong values with:
#   openssl rand -hex 32   → TOKEN_ENCRYPTOR_PASSWORD
#   openssl rand -hex 8    → TOKEN_ENCRYPTOR_SALT
# Never use the placeholder values below in production.
TOKEN_ENCRYPTOR_PASSWORD=REPLACE_ME_WITH_32_CHAR_HEX
TOKEN_ENCRYPTOR_SALT=REPLACE_ME_HEX8
